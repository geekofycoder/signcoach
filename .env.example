ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Required: Cartesia has no default voice. Pick an id from https://play.cartesia.ai/voices
CARTESIA_VOICE_ID=
# Optional
# Both default to claude-opus-5-5. Smaller models answer faster and cost less, e.g. claude-haiku-5-5.
VISION_MODEL=claude-opus-5-5
CHAT_MODEL=claude-opus-5-5
VISION_EFFORT=low
PORT=7860

# --- Only needed when hosted (see "Deploy on Railway" in the README) ---
# TURN relay. Railway cannot receive UDP, so camera and voice go through a relay. Use ONE of these:
# (a) Cloudflare: create a TURN key under Realtime > TURN (the dashboard asks for a card; free up to 1,000 GB).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# (b) Any provider (Metered, ExpressTURN, Xirsys, ...): paste the ICE servers array from their dashboard on
#     one line, e.g. [{"urls":"stun:host:80"},{"urls":"turns:host:443?transport=tcp","username":"u","credential":"p"}]
#     Ignored when the Cloudflare values above are set.
ICE_SERVERS_JSON=
# (c) Metered: just the username and password of a credential (dashboard.metered.ca > TURN Server > Credentials).
#     The free plan relays 500 MB a month, then stops until the next cycle.
METERED_USERNAME=
METERED_PASSWORD=
# Anyone with the page address can spend your API credits. Set a passcode (blank = open).
APP_PASSCODE=
# Spending limits: seconds per session (0 = no limit) and sessions at the same time.
MAX_SESSION_SECONDS=900
MAX_SESSIONS=2
